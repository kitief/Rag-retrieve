# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# pytest's --basetemp scratch dirs (60 MB of generated PDFs/DOCX fixtures otherwise)
pytest-of-*/
pytest-*/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Uploads / data
uploads/
chroma_data/
ollama_models/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Local GGUF weights (root-level only — `backend/app/models/` holds ORM models)
/models/
*.gguf

# Desktop build / single-process development
.venv-desktop/
.desktop-data/
src-tauri/target/
src-tauri/binaries/
build/desktop/

# Transient build scratch (esbuild TMPDIR, pip/gym caches created in-repo by tooling)
frontend/.esbuild-tmp/
data-gym-cache/
pip-unpack-*/

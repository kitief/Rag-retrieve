# ─────────────────────────────────────────────
#  RagVault — Environment Config
#  Copy to .env and fill in values before starting
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=knowledge_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=knowledge_hub
DATABASE_URL=postgresql+asyncpg://knowledge_user:changeme_strong_password@postgres:5432/knowledge_hub

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Cloud LLM (OpenAI-compatible API) ────────
# provider: deepseek (默认，官方推荐) | openai | custom
#   deepseek → https://api.deepseek.com/v1 + deepseek-chat
#   openai   → https://api.openai.com/v1 + gpt-4o-mini
#   custom   → 用你自己填的 LLM_BASE_URL / LLM_MODEL（任何 OpenAI 兼容端点）
# LLM_API_KEY 必须填写，否则聊天/出题/笔记只会返回"未配置"提示。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4

# ── Language（界面与 AI 输出语言）──────────────
# en = English，zh = 简体中文。
# 这里设的是"部署默认值"：浏览器右上角（侧栏底部）的语言开关可以按访客
# 单独覆盖，并通过 X-App-Language 请求头传给后端，所以 AI 问答/出题/笔记
# 也会跟着切换语言。已手动选过语言的浏览器不会被这个值覆盖。
APP_LANGUAGE=zh

# ── Shelved capabilities（音视频转写 / 图片 OCR）──
# 解析代码完整保留在 backend/app/utils/parsers.py，改成 true 即可重新启用；
# 同时需要恢复 backend/Dockerfile 里的 tesseract-ocr / ffmpeg 与
# requirements.txt 里的 pytesseract / faster-whisper。
ENABLE_AUDIO_VIDEO_UPLOADS=false
ENABLE_OCR_UPLOADS=false

# ── Embeddings (FastEmbed ONNX，本地运行) ────
# 必须与 ChromaDB 已有集合的维度一致：bge-small = 384 维。
# 换成 bge-base 会变成 768 维，导致旧集合检索静默失效。
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/chroma_data

# ── File Storage ──────────────────────────────
UPLOAD_TEMP_DIR=/uploads/temp

# ── RAG / Chunking ───────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5

# ── Shelved: Whisper（本地语音转写）──────────
# 仅当 ENABLE_AUDIO_VIDEO_UPLOADS=true 时才会加载。
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── Backend ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# ── HuggingFace Cache ─────────────────────────
# Embedding model is stored here — persisted via Docker volume
HF_HOME=/hf_cache
# The embedder downloads BAAI/bge-small-en-v1.5 once on first upload and keeps
# it in HF_HOME. Leave offline mode OFF until that first download has happened,
# otherwise ingestion fails with "offline mode is enabled".
# After the model is cached you may set these back to 1.
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
HF_DATASETS_OFFLINE=0
# 国内网络可填 https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com

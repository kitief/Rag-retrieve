# ─────────────────────────────────────────────
#  RagVault — developer overrides (optional)
# ─────────────────────────────────────────────
# RagVault is a Windows desktop app: the Tauri shell starts one Python process
# and every mutable file lives under %APPDATA%\RagVault. Nothing here is needed
# to run the installed app — the API key and the language are set in the
# in-app Settings dialog and stored in the local SQLite database.
#
# This file only exists for running the backend directly:
#
#     .venv-desktop\Scripts\python.exe -m uvicorn app.main:app --app-dir backend
#
# Copy it to .env in this directory. `scripts\run_desktop.py` deliberately
# ignores .env (it sets RAGVAULT_ENV_FILE="") so a stray developer file can
# never leak into a packaged profile; set RAGVAULT_ENV_FILE=.env yourself if
# you want these values during a dev run.
#
# All paths default to the data directory, so leave them blank unless you are
# deliberately pointing at another profile.

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Cloud LLM (OpenAI-compatible API) ────────
# provider: deepseek (默认，官方推荐) | openai | custom
#   deepseek → https://api.deepseek.com/v1 + deepseek-chat
#   openai   → https://api.openai.com/v1 + gpt-4o-mini
#   custom   → 用你自己填的 LLM_BASE_URL / LLM_MODEL（任何 OpenAI 兼容端点）
# 留空也行：首次启动时在应用的「设置」里填 API Key 即可。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4

# ── Language（界面与 AI 输出语言）──────────────
# en = English，zh = 简体中文。
# 这里设的是"内置默认值"：应用内的语言开关可以单独覆盖，并通过
# X-App-Language 请求头传给后端，所以 AI 问答/出题/笔记也会跟着切换语言。
APP_LANGUAGE=zh

# ── Shelved capabilities（音视频转写暂封存）──
# 解析代码完整保留在 backend/app/utils/parsers.py，改成 true 即可重新启用；
# 同时需要安装 ffmpeg 并恢复 requirements.txt 里的 faster-whisper。
ENABLE_AUDIO_VIDEO_UPLOADS=false

# ── PDF 分层解析 / OCR ────────────────────────
# 开启后：先逐页审计（原生文字层 / 扫描页 / 混合页 / 空白页），只对
# 「有图但没有可用文字层」的页面跑 OCR，并把每页的来源与置信度写进解析报告。
# 引擎默认 auto：优先 RapidOCR（纯 ONNX，模型随 wheel 分发，无需系统依赖），
# 缺失时回退 Tesseract（需要额外安装 tesseract-ocr 与中文语言包）。
ENABLE_OCR_UPLOADS=true
PDF_OCR_ENGINE=auto
# 300 DPI + 长边压到 1600：实测再提高 DPI 不会提升中文识别率，只会更慢。
PDF_OCR_DPI=300
PDF_OCR_MAX_SIDE=1600
# 0 = 不限制页数。对几百页的扫描书设个上限可以避免单次上传跑上半小时。
PDF_OCR_MAX_PAGES=0
# 单份文档 OCR 的总时间预算（秒），超时后剩下的页会标记为「未读取」。
PDF_OCR_TIME_BUDGET_SECONDS=1800
PDF_OCR_MIN_CONFIDENCE=0.75
PDF_OCR_MAX_ATTEMPTS=3
# OCR 引擎的 ONNX 线程数。默认给到 CPU 数的一倍会互相抢核，反而更慢：
# 同一批页面实测，库默认每核一线程 12.4 秒/页，限到 8 线程 7.5 秒/页。
# 填 0 = 完全交给库自己决定。
PDF_OCR_THREADS=8
# 文本层字符数低于此值、且整页被图片覆盖时，判为「需要 OCR」。
PDF_MIN_TEXT_CHARS=200
PDF_EXTRACT_TABLES=true

# ── Embeddings (FastEmbed ONNX，本地运行) ────
# 必须与 ChromaDB 已有集合的维度一致：bge-small = 384 维。
# 换成 bge-base 会变成 768 维，导致旧集合检索静默失效。
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Paths（留空 = 数据目录下的默认位置）────────
# DATA_DIR=%APPDATA%\RagVault
# DATABASE_URL=sqlite+aiosqlite:///C:/Users/you/AppData/Roaming/RagVault/ragvault.db
# CHROMA_PERSIST_DIR=
# UPLOAD_TEMP_DIR=
# HF_HOME=

# ── RAG / Chunking ───────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5

# ── Shelved: Whisper（本地语音转写）──────────
# 仅当 ENABLE_AUDIO_VIDEO_UPLOADS=true 时才会加载。
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── Backend ───────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info

# ── HuggingFace Cache ─────────────────────────
# The embedder downloads BAAI/bge-small-en-v1.5 once on first upload and keeps
# it in HF_HOME. Leave offline mode OFF until that first download has happened,
# otherwise ingestion fails with "offline mode is enabled".
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
HF_DATASETS_OFFLINE=0
# 国内网络可填 https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com
